  "deprecated_terms": [
    {
      "pattern": "(?<!global )\\bhub(s)?\\b",
      "replacement": "transit party / transit parties",
      "reason": "Hub implies a protocol actor. AMS roles are local edge positions."
    },
    {
      "pattern": "\\bsettlement anchor(s)?\\b",
      "replacement": "settlement origin",
      "reason": "Settlement origin is the canonical local role."
    },
    {
      "pattern": "\\bsettlement set(s)?\\b",
      "replacement": "Settlement Context",
      "reason": "The relation is implicit and must not be described as a materialized set."
    },
    {
      "pattern": "\\bA Bond is (?:a )?(?:pairwise )?(?:cryptographic )?relationship\\b",
      "replacement": "Bond as an authority-bearing protocol participant",
      "reason": "BondChain, not Bond, owns one causally bounded bilateral interaction."
    },
    {
      "pattern": "\\bBond sale(s)?\\b",
      "replacement": "bnd transfer",
      "reason": "A Bond is a participant and is not a saleable asset."
    },
    {
      "pattern": "\\bBond graph\\b",
      "replacement": "local relationship projection",
      "reason": "The protocol does not materialize a global graph of Bond relationships."
    }
  ],
  "canonical_code_terms": [
    "bch",
